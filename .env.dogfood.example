# Copy to examples/.env — dogfood the Owlpane SaaS like a real customer org.
#
# 1. Console → your org → Projects & keys → New project (repeat for each name below).
# 2. Copy each ingest key once into the matching variable.
# 3. ./run-dogfood.sh
#
# Onboarding contract (same as InstallGuide in the console):
#   OTEL_EXPORTER_OTLP_ENDPOINT = ingest URL
#   OWLPANE_INGEST_KEY          = this project's key only
#   OTEL_SERVICE_NAME           = project slug (matches names below)
#   deployment.environment.name = OWLPANE_ENVIRONMENT

OWLPANE_INGEST_URL=http://127.0.0.1:4318
OWLPANE_ENVIRONMENT=development

OWLPANE_INGEST_KEY_NODE=owl_ing_REPLACE_WITH_CONSOLE_KEY_48_HEX_CHARS________
OWLPANE_INGEST_KEY_GO=owl_ing_REPLACE_WITH_CONSOLE_KEY_48_HEX_CHARS________
OWLPANE_INGEST_KEY_PYTHON=owl_ing_REPLACE_WITH_CONSOLE_KEY_48_HEX_CHARS________
OWLPANE_INGEST_KEY_JAVA=owl_ing_REPLACE_WITH_CONSOLE_KEY_48_HEX_CHARS________
OWLPANE_INGEST_KEY_RUBY=owl_ing_REPLACE_WITH_CONSOLE_KEY_48_HEX_CHARS________

# Optional: one key for quick smoke (all apps share a single project — not recommended).
# OWLPANE_INGEST_KEY=owl_ing_...
