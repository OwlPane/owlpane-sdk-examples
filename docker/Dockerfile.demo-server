# Same as docker/apps/demo-server.Dockerfile — build context is repo root.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
ARG SDK_VERSION
WORKDIR /app
RUN apk add --no-cache tini bash
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app -h /home/app app
COPY sdk-published.version ./sdk-published.version
COPY docker/resolve-sdk-version.sh /docker/resolve-sdk-version.sh
RUN chmod +x /docker/resolve-sdk-version.sh
COPY apps/demo-server/src ./src
RUN SDK_V="$(/docker/resolve-sdk-version.sh)" \
  && npm init -y >/dev/null \
  && npm pkg set type=module \
  && npm pkg set scripts.start="node --import tsx src/server.ts" \
  && npm install --no-audit --no-fund "@owlpane/node@${SDK_V}" tsx@4.23.15 typescript@5.9.3
# Run as an unprivileged user; the entrypoint writes only under /app and $HOME.
RUN chown -R 10001:10001 /app
USER 10001:10001
ENV HOME=/home/app
ENV NODE_ENV=production \
    OWLPANE_METRICS_EXPORT_INTERVAL_MS=5000 \
    DEMO_INTERVAL_MS=3000 \
    DEMO_BIND_HOST=0.0.0.0 \
    DEMO_SERVER_PORT=4399
EXPOSE 4399
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "start"]
