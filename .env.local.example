# Local Owlpane full-stack example configuration
# Copy to examples/.env or generate automatically via:
#   ./scripts/onboard-dogfood.sh --write-env

# Control plane API (projects, ingest keys, dashboards, alerts)
OWLPANE_API_URL=http://127.0.0.1:4100
# Web console (Vite dev server; same-origin proxy to API)
OWLPANE_CONSOLE_URL=http://127.0.0.1:4200

# Telemetry cell OTLP/HTTP gateway (:4318 HTTP, :4317 gRPC)
OWLPANE_INGEST_URL=http://127.0.0.1:4318

# Deployment environment tag (deployment.environment.name)
OWLPANE_ENVIRONMENT=development

# Onboarding credentials used by scripts/onboard-dogfood.mjs
OWLPANE_ONBOARD_EMAIL=scale@owlpane.test
OWLPANE_ONBOARD_PASSWORD=owlpane
OWLPANE_ORG_SLUG=scale

# Dogfood telemetry richness ("minimal" for 1 span, "rich" for traces + metrics + logs + errors)
OWLPANE_DOGFOOD_MODE=rich

# Per-project ingest keys (populated by ./scripts/onboard-dogfood.sh --write-env)
OWLPANE_INGEST_KEY_NODE=owl_ing_000000000000000000000000000000000000000000000000
OWLPANE_INGEST_KEY_GO=owl_ing_000000000000000000000000000000000000000000000000
OWLPANE_INGEST_KEY_PYTHON=owl_ing_000000000000000000000000000000000000000000000000
OWLPANE_INGEST_KEY_JAVA=owl_ing_000000000000000000000000000000000000000000000000
OWLPANE_INGEST_KEY_RUBY=owl_ing_000000000000000000000000000000000000000000000000
OWLPANE_INGEST_KEY_BROWSER=owl_ing_000000000000000000000000000000000000000000000000
