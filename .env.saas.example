# Dogfood Owlpane SaaS (Scale org) — copy to examples/.env and fill secrets.
# Do not commit .env.

# CrikIQ-hosted cell (Amplify console + public API). Ingest URL: console Setup → Projects & keys
# (must match OWLPANE_PUBLIC_INGEST_URL on the API, or your org dedicated ingest_url).
OWLPANE_API_URL=https://owlpane-api.crikiq.com
# Laptop → cluster: ./scripts/saas-ingest-port-forward.sh start  then:
OWLPANE_INGEST_URL=http://127.0.0.1:14318
OWLPANE_CONSOLE_URL=https://main.d10cg0pp5t9xbx.amplifyapp.com

OWLPANE_ENVIRONMENT=production
OWLPANE_DOGFOOD_MODE=rich

OWLPANE_ONBOARD_EMAIL=scale@owlpane.test
OWLPANE_ONBOARD_PASSWORD=
OWLPANE_ORG_SLUG=scale

# After: ./scripts/onboard-dogfood.sh --write-env  (merges keys; keeps URLs above)
# OWLPANE_INGEST_KEY_NODE=owl_ing_...
# OWLPANE_INGEST_KEY_DEMO=...
# OWLPANE_INGEST_KEY_PII=...
